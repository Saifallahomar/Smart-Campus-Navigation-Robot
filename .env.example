# Copy this file to ".env" and fill in your own values.
# The real ".env" is ignored by git and must NEVER be committed.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-key-here

# Optional: only needed if you enable the Porcupine wake word engine
# (set wake_word.engine to "porcupine" in config/config.json)
PORCUPINE_ACCESS_KEY=
